---
import { Icon } from "astro-icon/components";
import { umamiConfig } from "../config";

type Props = {
	pathname: string;
	suffix?: string;
	id?: string;
};

const { pathname, suffix = "次" } = Astro.props;
const id =
	Astro.props.id ?? `page-views-${pathname.replace(/[^a-zA-Z0-9]+/g, "-")}`;
---

{
	umamiConfig.enable && (
		<div class="flex items-center">
			<div class="meta-icon">
				<Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
			</div>
			<span class="text-50 text-sm font-medium" id={id}>0 {suffix}</span>
		</div>
	)
}

<script define:vars={{ pathname, id, suffix, umamiConfig }}>
	async function loadViews() {
		const el = document.getElementById(id);
		if (!el) return;
		try {
			const tokenRes = await fetch(
				`${umamiConfig.baseUrl}/api/share/${umamiConfig.shareId}`,
				{ headers: { "x-umami-share-context": "1" } },
			);
			if (!tokenRes.ok) return;
			const tokenData = await tokenRes.json();
			if (!tokenData.token) return;

			const params = new URLSearchParams({
				path: pathname,
				startAt: "0",
				endAt: String(Date.now()),
			});
			const res = await fetch(
				`${umamiConfig.baseUrl}/api/websites/${umamiConfig.websiteId}/stats?${params}`,
				{
					headers: {
						"x-umami-share-token": tokenData.token,
						"x-umami-share-context": "1",
					},
				},
			);
			if (!res.ok) return;
			const data = await res.json();
			const views =
				typeof data.pageviews === "number"
					? data.pageviews
					: (data.pageviews?.value ?? 0);
			const current = Number.parseInt(el.textContent || "0", 10) || 0;
			if (current === 0) animateValueWithSuffix(el, 0, views, 1000, suffix);
			else el.innerHTML = `${views} ${suffix}`;
		} catch {}
	}

	if (document.readyState === "loading")
		document.addEventListener("DOMContentLoaded", loadViews);
	else loadViews();
	document.addEventListener("astro:after-swap", loadViews);
	document.addEventListener("content:replace", loadViews);
	document.addEventListener("swup:contentReplaced", loadViews);
</script>
