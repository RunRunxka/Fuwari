---
import { Icon } from "astro-icon/components";
---

<div class="back-to-top-wrapper hidden lg:block">
	<div id="go-to-comments-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="goToComments()">
		<button aria-label="Go to Comments" class="btn-card h-[3.75rem] w-[3.75rem]">
			<Icon name="mingcute:comment-fill" class="mx-auto"></Icon>
		</button>
	</div>
	<div id="back-to-top-btn" class="back-to-top-btn hide rounded-full overflow-hidden transition" onclick="backToTop()">
		<button aria-label="Back to Top" class="relative btn-card h-[3.25rem] w-[3.25rem] rounded-full flex items-center justify-center">
			<svg class="progress-ring absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 52 52">
				<circle cx="26" cy="26" r="22" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3" />
				<circle id="progress-ring-circle" cx="26" cy="26" r="22" fill="none" stroke="var(--primary)" stroke-width="3" stroke-linecap="round" stroke-dasharray="138.23" stroke-dashoffset="138.23" />
			</svg>
			<Icon name="material-symbols:keyboard-arrow-up-rounded" class="relative z-10"></Icon>
		</button>
	</div>
</div>

<style lang="stylus">
.back-to-top-wrapper
	width: 3.75rem
	height: 3.75rem
	position: absolute
	right: 0
	top: 0
	pointer-events: none

.back-to-top-btn
	color: var(--primary)
	font-size: 2.25rem
	font-weight: bold
	border: none
	position: fixed
	bottom: 10rem
	opacity: 1
	cursor: pointer
	transform: translateX(5rem)
	pointer-events: auto
	z-index: 50

	i
		font-size: 1.75rem

	&.hide
		transform: translateX(5rem) scale(0.8)
		opacity: 0
		pointer-events: none

	&:active
		transform: translateX(5rem) scale(0.9)

#go-to-comments-btn
	bottom: 14.5rem
</style>

<script is:raw is:inline>
function backToTop() {
	window.scroll({ top: 0, behavior: 'smooth' });
}

function goToComments() {
	const comments = document.getElementById('giscus-container');
	if (comments) {
		comments.scrollIntoView({ behavior: 'smooth' });
	}
}

const CIRCUMFERENCE = 2 * Math.PI * 22; // r=22

function updateProgressRing() {
	const circle = document.getElementById('progress-ring-circle');
	if (!circle) return;

	const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
	const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
	if (scrollHeight <= 0) {
		circle.style.strokeDashoffset = CIRCUMFERENCE;
		return;
	}
	const progress = Math.min(scrollTop / scrollHeight, 1);
	const offset = CIRCUMFERENCE * (1 - progress);
	circle.style.strokeDashoffset = offset;
}

let ringTicking = false;
window.addEventListener('scroll', () => {
	if (!ringTicking) {
		requestAnimationFrame(() => {
			updateProgressRing();
			ringTicking = false;
		});
		ringTicking = true;
	}
}, { passive: true });

document.addEventListener('swup:contentReplaced', updateProgressRing);
updateProgressRing();
</script>
